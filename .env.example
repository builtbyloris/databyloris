# Required in Vercel Preview and Production. These values are publishable and
# are bundled into the browser where needed; obtain them from Supabase Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required server-only allowlist for the single databyloris administrator.
# Never rename this with a NEXT_PUBLIC_ prefix.
ADMIN_EMAIL=
